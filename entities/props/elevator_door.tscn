# 0.8 never slid the (scaled ~1.99m-wide) door clear of the 1.5m ElevatorDoorHole - see the
# ElevatorDoorHole/ELEVATOR_DOOR_SCALE_X comments (elevator_shaft.tscn / hotel_level_generator.gd)
# for the full "vanished behind the hotel wall" story. With the door now ~1.3m wide and the hole
# 1.2m, 1.3 slides its near edge (starts at -0.65 from center) past the hole's edge (0.6) with a
# small margin, landing its far edge at 1.3+0.65=1.95 - still inside the car's own side wall at
# X=2.25, so nothing punches through into the hotel wall beyond it.
open_offset = Vector3(1.3, 0, 0)
move_time = 1.5

