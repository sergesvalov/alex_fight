[node name="ElevatorDoorHole" type="CSGBox3D" parent="ElevatorGeometry"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.15, 0.1)
operation = 2
# Hole stayed 1.2m wide through the 2026-08-24 door redesign - what changed is the door itself
# (elevator_door.tscn), which used to be one panel squeezed by a generator-side X scale
# (HotelLevelGenerator.ELEVATOR_DOOR_SCALE_X, since removed) to fit this hole and had to travel
# its FULL width to clear it, leaving only ~0.25m of margin before punching through the car's
# own side wall. It's now two panels (sliding_door_pair.gd) sized directly at 0.65m each,
# meeting with a small overlap in the closed position, each only needing to clear HALF this
# hole's width when opening - see that scene's own comment for the full clearance numbers.
size = Vector3(1.2, 2.5, 1.0)

# Doorway frame trim (2026-08-24) - a flat dark door sitting flush against the wallpaper with no
# surface detail read as an unlit "hole" rather than a door in-game (reported from a screenshot).
# Four independent CSGBox3D strips bordering ElevatorDoorHole on all sides, in a brighter brushed-
# steel material than either the door panels or the wallpaper, so the opening has a visible
# silhouette even under a dim flashlight. Deliberately standalone roots (like ElevatorFloor/
# Ceiling/SouthWall/Panel below), NOT children of the ElevatorGeometry combiner above - same CSG-
# subtraction-corruption reasoning as those (see AGENTS.md's CSG gotchas). Each protrudes 0.04m
# past both faces of ElevatorNorthWall (which spans local Z 0..0.2) so it reads from either side
# regardless of which way this whole block ends up mirrored (scale.z=-1.0, see
# hotel_level_generator.gd::_generate_elevator()).
[node name="ElevatorFrameTop" type="CSGBox3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.45, 0.1)
size = Vector3(1.36, 0.1, 0.28)
material = SubResource("StandardMaterial3D_frame")

