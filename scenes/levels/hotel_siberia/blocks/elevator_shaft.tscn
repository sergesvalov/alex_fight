[node name="ElevatorDoorHole" type="CSGBox3D" parent="ElevatorGeometry"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.15, 0.1)
operation = 2
# Narrowed again 1.5 -> 1.2 (2026-08-23): the *previous* fix (2.0 -> 1.5, see the stale comment
# this replaces) compared the 1.6m pocket it left against the door's NATIVE 1.4m mesh width,
# but the door is actually stretched by HotelLevelGenerator.ELEVATOR_DOOR_SCALE_X (was 1.42,
# now 0.93 - see that constant's own comment) to ~1.99m when placed - wider than even that
# "comfortably wide" 1.6m pocket, so the door could never fully retract into it: part of the
# panel always stuck out in the doorway, and the rest punched straight through the car's own
# ElevatorEastWall into the hotel wall beyond, i.e. exactly "the door vanished behind the hotel
# wall, leaving the hole visible" as reported in-game. At 0.93 scale the door is ~1.3m wide -
# still wider than this 1.2m hole (no gap when closed) but narrow enough to fit inside the
# resulting 1.65m pocket (2.25 - 0.6) once open_offset (elevator_door.tscn) slides it clear.
size = Vector3(1.2, 2.5, 1.0)

